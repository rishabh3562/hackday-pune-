# Copy to .env (never commit .env). Vertex AI / Gemini uses gcloud application-default credentials: `gcloud auth application-default login`
GCP_PROJECT=your-gcp-project-id
OPEN_ROUTER_API_KEY=            # fallback models only
OMNI_LIVEKIT_URL=wss://your-project.livekit.cloud
OMNI_LIVEKIT_API_KEY=
OMNI_LIVEKIT_API_SECRET=
# optional: COPILOT_CLARIFY=ask|auto  COPILOT_BACKEND=gemma  CRITIC=on|off  VECTOR_STORE=chroma|numpy
